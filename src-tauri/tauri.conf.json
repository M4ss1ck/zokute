{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zokute",
  "version": "0.1.0",
  "identifier": "com.example.zokute",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "7",
        "width": 96,
        "height": 72,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "center": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
