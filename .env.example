# Optional AI configuration for scripts/release.sh.
# Copy this file to .env. Without it, releases use a grouped commit list.

# Supported values: opencode, openai, or empty to disable AI.
CHANGELOG_AI_PROVIDER=opencode

# Required for opencode; optional for openai (defaults to gpt-4o-mini).
CHANGELOG_AI_MODEL=deepseek-v4-pro

# opencode Go: https://opencode.ai/docs/go
OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# OpenAI or another OpenAI-compatible endpoint.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
